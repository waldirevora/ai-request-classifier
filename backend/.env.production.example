# Reference only. Upload actual values as Render secret file /etc/secrets/solicitaflow.env.
# Never commit the populated file. PublicSettings refuses unsafe production configurations.
SF_ENV=production
SF_MAINTENANCE=true
SF_MAINTENANCE_TOKEN=
# Origin defaults to the exact HTTPS RENDER_EXTERNAL_URL; no wildcard.
SF_PUBLIC_ORIGIN=
PGHOST=
PGPORT=5432
PGDATABASE=solicitaflow_demo
PGUSER=ai_classifier_app
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=system
SF_CLEANUP_USER=ai_classifier_cleanup
SF_CLEANUP_PASSWORD=
SF_SECURE_LEGACY=true
SF_QA_MODE=false
SF_TRUSTED_PROXY_CIDRS=
AI_ENABLED=false
SF_REAL_AI_ENABLED=false
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash
SF_AI_DAILY_CALLS=10
SF_AI_WORKSPACE_CALLS=2
SF_AI_HOURLY_IP_CALLS=5
SF_AI_DAILY_TOKENS=100000
SF_AI_DAILY_USD=0.05
SF_AI_CONCURRENT=1
SF_AI_INPUT_USD_PER_M=0.60
SF_AI_OUTPUT_USD_PER_M=2.40
SF_LAB_DAILY_MAX=30
SF_LAB_ACTIVE_MAX=30
