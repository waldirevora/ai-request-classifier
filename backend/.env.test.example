# Somente o banco de testes isolado. Copie para backend/.env.test e configure localmente.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ai_request_classifier_test
PGUSER=ai_classifier_test
PGPASSWORD=SUBSTITUA_LOCALMENTE

# Nunca consuma API real durante pytest. As fixtures também bloqueiam o transporte.
AI_ENABLED=false
SF_REAL_AI_ENABLED=false
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash
SF_SECURE_LEGACY=true
SF_QA_MODE=false
