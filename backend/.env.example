# Exemplo LOCAL. Copie para backend/.env e defina a senha somente no seu ambiente.
# Não é configuração de produção; não cria roles, bancos ou tabelas.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ai_request_classifier
PGUSER=ai_classifier_app
PGPASSWORD=SUBSTITUA_LOCALMENTE

# Role limitada de runtime. ai_classifier_owner (NOLOGIN) é usada só na manutenção.
# Para testes, copie .env.test.example para .env.test; nunca use o banco principal.
SF_SECURE_LEGACY=true
SF_QA_MODE=false

# Ambos os controles precisam ser true para autorizar IA real. Padrão seguro: false.
# Preencha a chave apenas no backend; nunca use variáveis VITE_ para segredos.
AI_ENABLED=false
SF_REAL_AI_ENABLED=false
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

# Limites globais; custo é reserva conservadora, não teto de faturamento do provedor.
SF_AI_DAILY_CALLS=10
SF_AI_WORKSPACE_CALLS=4
SF_AI_HOURLY_IP_CALLS=10
SF_AI_DAILY_TOKENS=100000
SF_AI_DAILY_USD=0.05
SF_AI_CONCURRENT=1
SF_AI_INPUT_USD_PER_M=0.60
SF_AI_OUTPUT_USD_PER_M=2.40

# Contato opcional: somente um endereço profissional confirmado pelo proprietário.
# SF_CONTACT_URL=
# PostgreSQL remoto: validar TLS/CA e conexão direta antes de definir PGSSLMODE.
# Consulte docs/PRE_DEPLOY.md. Não altere o PostgreSQL local para preparar a nuvem.
